@* Marks an input the Ignition tab reads, so it is not repurposed by accident *@
@if (Uses is { Count: > 0 })
{
    <MudTooltip Text="@($"Used by the Ignition tab: {string.Join(", ", Uses)}")">
        <MudIcon Icon="@Icons.Material.Outlined.Key" Color="Color.Primary" Size="Size.Small"
                 Style="vertical-align: middle; margin-left: 4px;"/>
    </MudTooltip>
}

@code {
    [Parameter] public IReadOnlyList<string>? Uses { get; set; }
}
