@using domain.Enums
@using domain.Devices.Functions
@typeparam TDevice where TDevice : domain.Devices.FwDevice

<SparklineHost>
<div class="dash">
    <div class="dash-top">
        <div class="dash-stats">
            @if (Device.Def.HasBattVoltSense)
            {
                <div class="dash-stat">
                    <span class="dash-label">Battery</span>
                    <span class="dash-value">@Device.BatteryVoltage.ToString("F1")<small>V</small></span>
                    <Sparkline Source="Device" Property="@nameof(domain.Devices.FwDevice.BatteryVoltage)" Width="112" Height="22"/>
                </div>
            }
            @if (Device.Outputs.Count > 0)
            {
                <div class="dash-stat">
                    <span class="dash-label">Total current</span>
                    <span class="dash-value">@Device.TotalCurrent.ToString("F1")<small>A</small></span>
                    <Sparkline Source="Device" Property="@nameof(domain.Devices.FwDevice.TotalCurrent)" Width="112" Height="22"/>
                </div>
            }
            @if (Device.Def.HasExtTempSensor)
            {
                <div class="dash-stat">
                    <span class="dash-label">Board temperature</span>
                    <span class="dash-value">@Device.BoardTempC.ToString("F1")<small>°C</small></span>
                    <Sparkline Source="Device" Property="@nameof(domain.Devices.FwDevice.BoardTempC)" Width="112" Height="22"/>
                </div>
            }
            <div class="dash-stat @StateClass(Device.DeviceState)">
                <span class="dash-label">State</span>
                <span class="dash-value"><span class="dash-led"></span>@Device.DeviceState</span>
                <Sparkline Source="Device" Property="@nameof(domain.Devices.FwDevice.DeviceState)" Width="112" Height="22"/>
            </div>
            <div class="dash-stat">
                <span class="dash-label">Firmware</span>
                <span class="dash-value">@Device.Version</span>
                <span class="dash-note">CAN @GetBitRateDisplay(Device.BitRate)</span>
            </div>
            <div class="dash-stat dash-flags">
                @if (Device.Def.CanSleep)
                {
                    <span class="dash-flag @(Device.SleepEnabled ? "on" : "")"><span class="dash-led"></span>Sleep</span>
                }
                <span class="dash-flag @(Device.CanFiltersEnabled ? "on" : "")"><span class="dash-led"></span>CAN filters</span>
            </div>
        </div>

        <div class="dash-toolbar">
            @if (!_showDisabled && Hidden > 0)
            {
                <span class="dash-hidden">@Hidden disabled hidden</span>
            }
            <MudSwitch T="bool" @bind-Value="_showDisabled" Color="Color.Primary" Size="Size.Small">Show disabled</MudSwitch>
        </div>
    </div>

    @if (!_showDisabled && Shown == 0)
    {
        <div class="dash-empty">
            Nothing is enabled on this device yet. Enable outputs and inputs in the Configuration tab,
            or turn on Show disabled to see them all.
        </div>
    }

    @* Outputs *@
    @if (Visible(Device.Outputs, o => o.Enabled) is { Count: > 0 } outputs)
    {
        <section>
            @Head("Outputs", outputs.Count, Device.Outputs.Count)
            <div class="dash-grid dash-grid-out">
                @foreach (var output in outputs)
                {
                    <div class="dash-out @OutputClass(output.State) @Off(output.Enabled)">
                        <div class="dash-row">
                            <span class="dash-led"></span>
                            <span class="dash-name" title="@output.Name">@output.Name</span>
                            <span class="dash-badge">@GetOutputStateText(output.State)</span>
                        </div>
                        @if (output.PrimaryOutput < 0)
                        {
                            <div class="dash-amps">
                                <b>@output.Current.ToString("F1")</b><span>A</span>
                                <span class="dash-limit">of @output.CurrentLimit.ToString("0.#") A</span>
                            </div>
                            <div class="dash-meter" title="Current against the current limit">
                                <i style="width: @LoadPercent(output)%"></i>
                            </div>
                            <Sparkline Source="output" Property="@nameof(Output.Current)" Width="182" Height="26"/>
                            @if (output.PwmEnabled || output.ResetCount > 0)
                            {
                                <div class="dash-foot">
                                    @if (output.PwmEnabled)
                                    {
                                        <span>PWM @output.CurrentDutyCycle.ToString("F0") %</span>
                                        <span title="Calculated current">≈ @output.CalculatedCurrent.ToString("F1") A</span>
                                    }
                                    @if (output.ResetCount > 0)
                                    {
                                        <span class="dash-warn">@output.ResetCount reset@(output.ResetCount == 1 ? "" : "s")</span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="dash-follow">Follows output @(output.PrimaryOutput + 1)</div>
                        }
                    </div>
                }
            </div>
        </section>
    }

    @* Digital Inputs *@
    @if (Visible(Device.DigitalInputs, i => i.Enabled) is { Count: > 0 } digitalInputs)
    {
        <section>
            @Head("Digital inputs", digitalInputs.Count, Device.DigitalInputs.Count)
            <div class="dash-grid dash-grid-sig">
                @foreach (var input in digitalInputs)
                {
                    @Signal(input, nameof(DigitalInput.State), input.Name, input.Enabled, input.State, OnOff(input.State))
                }
            </div>
        </section>
    }

    @* Digital Outputs *@
    @if (Visible(Device.DigitalOutputs, o => o.Enabled) is { Count: > 0 } digitalOutputs)
    {
        <section>
            @Head("Digital outputs", digitalOutputs.Count, Device.DigitalOutputs.Count)
            <div class="dash-grid dash-grid-sig">
                @foreach (var output in digitalOutputs)
                {
                    @Signal(output, nameof(DigitalOutput.State), output.Name, output.Enabled, output.State, OnOff(output.State))
                }
            </div>
        </section>
    }

    @* Analog Inputs *@
    @if (Visible(Device.AnalogInputs, i => i.Enabled) is { Count: > 0 } analogInputs)
    {
        <section>
            @Head("Analog inputs", analogInputs.Count, Device.AnalogInputs.Count)
            <div class="dash-grid dash-grid-out">
                @foreach (var input in analogInputs)
                {
                    <div class="dash-out @(input.Switch.State ? "on" : "") @Off(input.Enabled)">
                        <div class="dash-row">
                            <span class="dash-led" title="Digital state"></span>
                            <span class="dash-name" title="@input.Name">@input.Name</span>
                            <span class="dash-badge">@OnOff(input.Switch.State)</span>
                        </div>
                        <div class="dash-amps">
                            <b>@input.Millivolts.ToString("F0")</b><span>mV</span>
                            <span class="dash-limit">rotary @input.Rotary.Pos</span>
                        </div>
                        <Sparkline Source="input" Property="@nameof(AnalogInput.Millivolts)" Width="182" Height="26"/>
                    </div>
                }
            </div>
        </section>
    }

    @* CAN Inputs *@
    @if (Visible(Device.CanInputs, i => i.Enabled) is { Count: > 0 } canInputs)
    {
        <section>
            @Head("CAN inputs", canInputs.Count, Device.CanInputs.Count)
            <div class="dash-grid dash-grid-sig">
                @foreach (var input in canInputs)
                {
                    @Signal(input, nameof(CanInput.Value), input.Name, input.Enabled, input.Output, input.Value.ToString())
                }
            </div>
        </section>
    }

    @* Virtual Inputs *@
    @if (Visible(Device.VirtualInputs, i => i.Enabled) is { Count: > 0 } virtualInputs)
    {
        <section>
            @Head("Virtual inputs", virtualInputs.Count, Device.VirtualInputs.Count)
            <div class="dash-grid dash-grid-sig">
                @foreach (var input in virtualInputs)
                {
                    @Signal(input, nameof(VirtualInput.Value), input.Name, input.Enabled, input.Value, OnOff(input.Value))
                }
            </div>
        </section>
    }

    @* Conditions *@
    @if (Visible(Device.Conditions, c => c.Enabled) is { Count: > 0 } conditions)
    {
        <section>
            @Head("Conditions", conditions.Count, Device.Conditions.Count)
            <div class="dash-grid dash-grid-sig">
                @foreach (var condition in conditions)
                {
                    @Signal(condition, nameof(Condition.Value), condition.Name, condition.Enabled, condition.Value > 0, condition.Value.ToString())
                }
            </div>
        </section>
    }

    @* Counters *@
    @if (Visible(Device.Counters, c => c.Enabled) is { Count: > 0 } counters)
    {
        <section>
            @Head("Counters", counters.Count, Device.Counters.Count)
            <div class="dash-grid dash-grid-sig">
                @foreach (var counter in counters)
                {
                    @Signal(counter, nameof(Counter.Value), counter.Name, counter.Enabled, counter.Value > 0, counter.Value.ToString())
                }
            </div>
        </section>
    }

    @* Flashers *@
    @if (Visible(Device.Flashers, f => f.Enabled) is { Count: > 0 } flashers)
    {
        <section>
            @Head("Flashers", flashers.Count, Device.Flashers.Count)
            <div class="dash-grid dash-grid-sig">
                @foreach (var flasher in flashers)
                {
                    @Signal(flasher, nameof(Flasher.Value), flasher.Name, flasher.Enabled, flasher.Value, OnOff(flasher.Value))
                }
            </div>
        </section>
    }

    @* Wiper *@
    @if (Device.Def.HasWipers && (Device.Wipers.Enabled || _showDisabled))
    {
        var wiper = Device.Wipers;
        <section>
            @Head("Wiper", 1, 1)
            <div class="dash-grid dash-grid-out">
                <div class="dash-out @(wiper.State is WiperState.Parked ? "" : "on") @Off(wiper.Enabled)">
                    <div class="dash-row">
                        <span class="dash-led"></span>
                        <span class="dash-name" title="@wiper.Name">@wiper.Name</span>
                        <span class="dash-badge">@wiper.State</span>
                    </div>
                    <div class="dash-chips">
                        <span class="dash-flag @(wiper.SlowState ? "on" : "")"><span class="dash-led"></span>Slow</span>
                        <span class="dash-flag @(wiper.FastState ? "on" : "")"><span class="dash-led"></span>Fast</span>
                        <span class="dash-limit">mode @wiper.Mode</span>
                    </div>
                    <Sparkline Source="wiper" Property="@nameof(Wiper.State)" Width="182" Height="26"/>
                </div>
            </div>
        </section>
    }

    @* Starter Disable *@
    @if (Device.Def.HasStarterDisable && (Device.StarterDisable.Enabled || _showDisabled))
    {
        var starter = Device.StarterDisable;
        <section>
            @Head("Starter disable", 1, 1)
            <div class="dash-grid dash-grid-out">
                <div class="dash-out @Off(starter.Enabled)">
                    <div class="dash-row">
                        <span class="dash-name" title="@starter.Name">@starter.Name</span>
                    </div>
                    <div class="dash-chips">
                        @for (var i = 0; i < starter.OutputsDisabled.Count; i++)
                        {
                            <span class="dash-flag @(starter.OutputsDisabled[i] ? "on" : "")"><span class="dash-led"></span>Output @(i + 1)</span>
                        }
                    </div>
                </div>
            </div>
        </section>
    }
</div>
</SparklineHost>

@code {
    [Parameter, EditorRequired] public TDevice Device { get; set; } = null!;

    private bool _showDisabled;

    private List<T> Visible<T>(IEnumerable<T> items, Func<T, bool> enabled) =>
        _showDisabled ? items.ToList() : items.Where(enabled).ToList();

    /// <summary>Everything the dashboard can show that is enabled</summary>
    private int Shown => Count(true);

    /// <summary>Everything left out because it is disabled</summary>
    private int Hidden => Count(false);

    private int Count(bool enabled)
    {
        var flags = Device.Outputs.Select(o => o.Enabled)
            .Concat(Device.DigitalInputs.Select(i => i.Enabled))
            .Concat(Device.DigitalOutputs.Select(o => o.Enabled))
            .Concat(Device.AnalogInputs.Select(i => i.Enabled))
            .Concat(Device.CanInputs.Select(i => i.Enabled))
            .Concat(Device.VirtualInputs.Select(i => i.Enabled))
            .Concat(Device.Conditions.Select(c => c.Enabled))
            .Concat(Device.Counters.Select(c => c.Enabled))
            .Concat(Device.Flashers.Select(f => f.Enabled));
        if (Device.Def.HasWipers) flags = flags.Append(Device.Wipers.Enabled);
        if (Device.Def.HasStarterDisable) flags = flags.Append(Device.StarterDisable.Enabled);
        return flags.Count(f => f == enabled);
    }

    private RenderFragment Head(string title, int shown, int total) =>
        @<div class="dash-head">
            <span class="dash-title">@title</span>
            @if (total > 1)
            {
                <span class="dash-count">@(shown == total ? total.ToString() : $"{shown} of {total}")</span>
            }
        </div>;

    // One live value: a light, its name and value, and a short trend under them
    private RenderFragment Signal(object source, string property, string name, bool enabled, bool active, string value) =>
        @<div class="dash-sig @(active ? "on" : "") @Off(enabled)">
            <span class="dash-led"></span>
            <span class="dash-name" title="@name">@name</span>
            <span class="dash-val">@value</span>
            <Sparkline Source="source" Property="@property" Width="158" Height="16"/>
        </div>;

    private static string Off(bool enabled) => enabled ? "" : "is-disabled";

    private static string OnOff(bool state) => state ? "ON" : "OFF";

    private static double LoadPercent(Output output) =>
        output.CurrentLimit > 0 ? Math.Clamp(output.Current / output.CurrentLimit * 100, 0, 100) : 0;

    private static string StateClass(DeviceState state) => state switch
    {
        DeviceState.Run => "on",
        DeviceState.OverTemp => "warn",
        DeviceState.Error => "fault",
        _ => ""
    };

    private static string OutputClass(OutState state) => state switch
    {
        OutState.On => "on",
        OutState.Overcurrent => "warn",
        OutState.Fault => "fault",
        _ => ""
    };

    private static string GetOutputStateText(OutState state) => state switch
    {
        OutState.On => "ON",
        OutState.Overcurrent => "OVERCURRENT",
        OutState.Fault => "FAULT",
        _ => "OFF"
    };

    private string GetBitRateDisplay(domain.Enums.CanBitRate bitRate) => bitRate switch
    {
        domain.Enums.CanBitRate.BitRate1000K => "1000K",
        domain.Enums.CanBitRate.BitRate500K => "500K",
        domain.Enums.CanBitRate.BitRate250K => "250K",
        domain.Enums.CanBitRate.BitRate125K => "125K",
        domain.Enums.CanBitRate.BitRate100K => "100K",
        _ => "Unknown"
    };
}
