@using web.Services
@using application.Services
@using domain.Interfaces
@using domain.Enums
@using infrastructure.Adapters
@inject ICommsAdapterManager CommsAdapterManager
@inject NotificationService Notification
@inject SimPlayback SimPlayback
@inject UserPreferencesManager UserPrefs
@inject IDialogService DialogService
@rendermode InteractiveServer
@implements IDisposable

<MudBadge Color="Color.Warning"
          Dot="true"
          Overlap="true"
          Bordered="true"
          Visible="@(_available.Ports.Length == 0)">
    <MudChip T="string"
             Icon="@Icons.Material.Filled.Cable"
             Color="@GetAdapterChipColor()"
             Variant="Variant.Outlined"
             Size="Size.Medium"
             OnClick="@((_) => TogglePopover())"
             Style="cursor: pointer;">
        @GetAdapterText()
    </MudChip>
</MudBadge>

<MudPopover Open="@_isOpen"
            AnchorOrigin="Origin.BottomRight"
            TransformOrigin="Origin.TopRight"
            OverflowBehavior="OverflowBehavior.FlipAlways">
    <MudPaper Class="pa-4" Style="min-width: min(400px, calc(100vw - 24px)); max-width: calc(100vw - 24px);" Elevation="8">
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Cable" Class="mr-2" />
                Adapter
            </MudText>

            @if (_status.IsConnected)
            {
                <!-- Connected State -->
                <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true">
                    <strong>Connected</strong>
                </MudAlert>

                <MudText Typo="Typo.body2" Class="mb-1"><strong>Adapter:</strong> @_status.ActiveAdapter</MudText>
                <MudText Typo="Typo.body2" Class="mb-1"><strong>Port:</strong> @_status.ActivePort</MudText>
                <MudText Typo="Typo.body2" Class="mb-1"><strong>Bitrate:</strong> @_status.ActiveBitRate.ToString().Remove(0,7)</MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.LinkOff"
                           OnClick="@DisconnectAdapter"
                           Disabled="@_disconnecting"
                           FullWidth="true">
                    @(_disconnecting ? "Disconnecting..." : "Disconnect")
                </MudButton>
            }
            else
            {
                <!-- Disconnected State -->
                <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                    <strong>Not Connected</strong>
                </MudAlert>

                <MudSelect Value="_selectedAdapterType"
                           Label="Adapter Type"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Class="mb-2"
                           ValueChanged="OnAdapterTypeChanged"
                           T="string">
                    @foreach (var adapter in _available.Adapters)
                    {
                        <MudSelectItem T="string" Value="@adapter">@adapter</MudSelectItem>
                    }
                </MudSelect>

                @if (_selectedAdapterType == "WiFi" && _wifiManual)
                {
                    <MudTextField @bind-Value="_wifiAddress"
                                  Label="Bridge address"
                                  Placeholder="192.168.4.1"
                                  HelperText="Port 3333 unless given, e.g. 192.168.1.50:3333"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mb-1"
                                  T="string"/>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mb-2" Style="text-transform: none"
                               StartIcon="@Icons.Material.Filled.Search"
                               OnClick="@(() => SetWifiManual(false))">
                        Find bridges on the network
                    </MudButton>
                }
                else if (_selectedAdapterType == "WiFi")
                {
                    <MudSelect Value="_wifiBridge"
                               ValueChanged="@((string? name) => _wifiBridge = name)"
                               Label="Bridge"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Class="mb-1"
                               Disabled="@(_bridges.Count == 0)"
                               HelperText="@WifiHelperText()"
                               T="string">
                        @foreach (var bridge in _bridges)
                        {
                            <MudSelectItem T="string" Value="@bridge.Name">
                                @bridge.Name <span class="mud-text-secondary">· @bridge.Address@(bridge.Busy ? " · in use" : "")</span>
                            </MudSelectItem>
                        }
                    </MudSelect>
                    <MudStack Row="true" Spacing="0" Class="mb-2" AlignItems="AlignItems.Center">
                        <MudTooltip Text="Search the network again">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                           Disabled="@_searching" OnClick="@SearchBridges"/>
                        </MudTooltip>
                        @if (SelectedBridge is { } shown)
                        {
                            <MudTooltip Text="Open the bridge's own page">
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                               Href="@($"http://{shown.Address}/")" Target="_blank"/>
                            </MudTooltip>
                        }
                        <MudSpacer/>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Style="text-transform: none"
                                   OnClick="@(() => SetWifiManual(true))">
                            Enter an address instead
                        </MudButton>
                    </MudStack>
                }

                @* Show port selector for USB and SLCAN only (not WiFi, PCAN or Sim) *@
                @if (!string.IsNullOrEmpty(_selectedAdapterType) && _selectedAdapterType != "Sim" && _selectedAdapterType != "PCAN" && _selectedAdapterType != "WiFi")
                {
                    <MudSelect @bind-Value="_selectedPort"
                               Label="Port"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Class="mb-2"
                               T="string">
                        @foreach (var port in _available.Ports)
                        {
                            <MudSelectItem T="string" Value="@port">@port</MudSelectItem>
                        }
                    </MudSelect>
                }

                @* Show bitrate selector for SLCAN and PCAN (not USB or Sim) *@
                @if (!string.IsNullOrEmpty(_selectedAdapterType) && _selectedAdapterType != "USB" && _selectedAdapterType != "Sim")
                {
                    <MudSelect @bind-Value="@_selectedBitrate"
                               Label="Bitrate"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Class="mb-3">
                        <MudSelectItem Value="@CanBitRate.BitRate1000K">1000K</MudSelectItem>
                        <MudSelectItem Value="@CanBitRate.BitRate500K">500K</MudSelectItem>
                        <MudSelectItem Value="@CanBitRate.BitRate250K">250K</MudSelectItem>
                        <MudSelectItem Value="@CanBitRate.BitRate125K">125K</MudSelectItem>
                        <MudSelectItem Value="@CanBitRate.BitRate100K">100K</MudSelectItem>
                    </MudSelect>
                }
                else
                {
                    @* Add spacing if bitrate is hidden *@
                    <div class="mb-3"></div>
                }

                @if (_available.Adapters.Length == 0 || (_available.Ports.Length == 0 && NeedsPort))
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                        @if (_available.Adapters.Length == 0)
                        {
                            <MudText Typo="Typo.caption">No adapters available</MudText>
                        }
                        @if (_available.Ports.Length == 0 && NeedsPort)
                        {
                            <MudText Typo="Typo.caption">No ports detected</MudText>
                        }
                    </MudAlert>
                }

                @* Open Log File button for Sim adapter *@
                @if (_selectedAdapterType == "Sim")
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               OnClick="@OpenLogFile"
                               FullWidth="true"
                               Class="mb-3">
                        Open Log File
                    </MudButton>
                }

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Link"
                               OnClick="@ConnectAdapter"
                               Disabled="@(!CanConnect())"
                               FullWidth="true">
                        @(_connecting ? "Connecting..." : "Connect")
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   OnClick="@RefreshAvailable"
                                   Color="Color.Default"
                                   Size="Size.Medium" />
                </MudStack>
            }
        }
    </MudPaper>
</MudPopover>

@code {
    private bool _isOpen;
    private (bool IsConnected, string? ActiveAdapter, string? ActivePort, CanBitRate ActiveBitRate) _status;
    private (string[] Adapters, string[] Ports) _available;
    private bool _loading = true;
    private bool _connecting;
    private bool _disconnecting;
    private Timer? _refreshTimer;

    private string _selectedAdapterType = string.Empty;
    private string _selectedPort = string.Empty;
    private string _wifiAddress = "192.168.4.1";
    private bool _wifiManual;
    private string? _wifiBridge;
    private IReadOnlyList<WifiBridge> _bridges = [];
    private bool _searching;
    private CanBitRate _selectedBitrate = CanBitRate.BitRate500K;

    protected override void OnInitialized()
    {
        // Load adapter settings from user preferences
        if (!string.IsNullOrEmpty(UserPrefs.Preferences.SelectedAdapter))
            _selectedAdapterType = UserPrefs.Preferences.SelectedAdapter;

        if (!string.IsNullOrEmpty(UserPrefs.Preferences.SelectedPort))
            _selectedPort = UserPrefs.Preferences.SelectedPort;
        
        _selectedBitrate = UserPrefs.Preferences.SelectedBitrate;

        if (!string.IsNullOrWhiteSpace(UserPrefs.Preferences.WifiAddress))
            _wifiAddress = UserPrefs.Preferences.WifiAddress;
        _wifiManual = UserPrefs.Preferences.WifiManualAddress;
        _wifiBridge = UserPrefs.Preferences.WifiBridge;

        LoadData();
        Refresh();

        // Refresh status every second
        _refreshTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                LoadData();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }
    
    private async Task TogglePopover()
    {
        _isOpen = !_isOpen;
        if (_isOpen) await SearchIfWifi();
    }

    private void LoadData()
    {
        _loading = true;
        try
        {
            _status = CommsAdapterManager.GetStatus();

            if (_status.IsConnected) return;
            if (string.IsNullOrEmpty(_selectedAdapterType) && _available.Adapters.Length > 0)
            {
                _selectedAdapterType = _available.Adapters[0];
            }
        }
        catch
        {
            // Silently fail
        }
        finally
        {
            _loading = false;
        }
    }

    private void RefreshAvailable()
    {
        try
        {
            Refresh();
            
            Notification.NewInfo("Adapter list refreshed");
        }
        catch (Exception ex)
        {
            Notification.NewError("Error refreshing adapters", ex);
        }
    }

    private void Refresh()
    {
        _available = CommsAdapterManager.GetAvailable();
        
        //Filter the available ports
        if (_selectedAdapterType == "SocketCAN")
        {
            _available.Ports = _available.Ports.Where(s => s.Contains("can")).ToArray();
            if (!_selectedPort.Contains("can") && _available.Adapters.Length > 0)
                _selectedPort = _available.Ports[0];
        }
        else
        {
            _available.Ports = _available.Ports.Where(s => !s.Contains("can")).ToArray();
            if (_selectedPort.Contains("can") && _available.Adapters.Length > 0)
                _selectedPort = _available.Ports[0];
        }
        
        if (string.IsNullOrEmpty(_selectedPort) && _available.Ports.Length > 0)
        {
            _selectedPort = _available.Ports[0];
        }
        
    }

    private async Task ConnectAdapter()
    {
        _connecting = true;
        try
        {
            // Set port based on adapter type
            string port = _selectedAdapterType switch
            {
                "Sim" => "Simulated",
                "PCAN" => "PCAN_USBBUS1", // Default PCAN port
                "WiFi" => _wifiManual ? _wifiAddress.Trim() : SelectedBridge?.Endpoint ?? string.Empty,
                _ => _selectedPort
            };

            // Get adapter instance
            var adapter = CommsAdapterManager.ToAdapter(_selectedAdapterType);
            var success = await CommsAdapterManager.ConnectAsync(adapter, port, _selectedBitrate, CancellationToken.None);

            if (success)
            {
                Notification.NewSuccess($"Connected to {_selectedAdapterType}");
                LoadData();

                // Save adapter settings to user preferences
                UserPrefs.Preferences.SelectedAdapter = _selectedAdapterType;
                UserPrefs.Preferences.SelectedPort = _selectedPort;
                UserPrefs.Preferences.SelectedBitrate = _selectedBitrate;
                if (_selectedAdapterType == "WiFi")
                {
                    UserPrefs.Preferences.WifiManualAddress = _wifiManual;
                    if (_wifiManual) UserPrefs.Preferences.WifiAddress = _wifiAddress.Trim();
                    else UserPrefs.Preferences.WifiBridge = SelectedBridge?.Name;
                }
                UserPrefs.Save();

                _isOpen = false; // Close popover on success
            }
            else
            {   
                Notification.NewError($"Failed to connect to {_selectedAdapterType}");
            }
        }
        catch (Exception ex)
        {
            Notification.NewError($"Error connecting: {_selectedAdapterType}", ex);
        }
        finally
        {
            _connecting = false;
        }
    }

    private async Task DisconnectAdapter()
    {
        _disconnecting = true;
        try
        {
            await CommsAdapterManager.DisconnectAsync();
            Notification.NewSuccess("Disconnected from adapter");
            LoadData();
            _isOpen = false; // Close popover on success
        }
        catch (Exception ex)
        {
            Notification.NewError("Error disconnecting", ex);
        }
        finally
        {
            _disconnecting = false;
        }
    }

    private bool CanConnect()
    {
        if (_connecting || string.IsNullOrWhiteSpace(_selectedAdapterType))
            return false;

        // Sim adapter doesn't need port or bitrate
        if (_selectedAdapterType == "Sim")
            return true;

        // WiFi needs a bridge found on the network, or its address
        if (_selectedAdapterType == "WiFi")
            return _wifiManual ? WifiAdapter.TryParseAddress(_wifiAddress, out _, out _) : SelectedBridge != null;

        // USB adapter needs port but not bitrate
        if (_selectedAdapterType == "USB")
            return !string.IsNullOrWhiteSpace(_selectedPort);

        // PCAN needs bitrate but not port
        if (_selectedAdapterType == "PCAN")
            return true;

        // SLCAN needs both port and bitrate
        return !string.IsNullOrWhiteSpace(_selectedPort);
    }

    private Color GetAdapterChipColor()
    {
        if (_status.IsConnected)
        {
            return Color.Success; // Green when connected
        }
        return Color.Default; // Gray when disconnected
    }

    private string GetAdapterText()
    {
        if (_status.IsConnected)
        {
            return $"Adapter: {_status.ActiveAdapter}";
        }
        return "Adapter: Disconnected";
    }

    private async Task OpenLogFile()
    {
        var parameters = new DialogParameters
        {
            { nameof(OpenFileDialog.FileFilter), "*.csv" }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        
        var dialog = await DialogService.ShowAsync<OpenFileDialog>("Open File", parameters, options);
        var dialogResult = await dialog.Result;
        
        if (dialogResult is { Canceled: false, Data: string fileName })
        {
            var (success, error) = await SimPlayback.LoadFile(fileName);
            if (success)
            {
                Notification.NewSuccess($"Loaded {Path.GetFileName(fileName)}");
            }
            else
            {
                Notification.NewError($"Failed to load file: {error}");
            }
        }
        
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    // Serial adapters pick a port from the list; WiFi, PCAN and Sim do not
    private bool NeedsPort => _selectedAdapterType is not ("WiFi" or "PCAN" or "Sim");

    private WifiBridge? SelectedBridge => _bridges.FirstOrDefault(b => b.Name == _wifiBridge);

    private string WifiHelperText()
    {
        if (_searching && _bridges.Count == 0) return "Searching the network...";
        if (_bridges.Count == 0) return "No bridge on this network. Is it on the same WiFi as this device?";
        return SelectedBridge is { Busy: true } ? "Another device is connected to it; connecting takes over" : "";
    }

    // Asks the network which bridges are there. Keeps the remembered one selected when it answers,
    // otherwise picks the first.
    private async Task SearchBridges()
    {
        if (_searching) return;
        _searching = true;
        StateHasChanged();
        try
        {
            _bridges = await WifiDiscovery.FindAsync(TimeSpan.FromMilliseconds(1500));
            if (SelectedBridge == null)
                _wifiBridge = _bridges.FirstOrDefault(b => b.Name == UserPrefs.Preferences.WifiBridge)?.Name
                              ?? _bridges.FirstOrDefault()?.Name;
        }
        catch (Exception ex)
        {
            Notification.NewError("Searching for WiFi bridges failed", ex);
        }
        finally
        {
            _searching = false;
            StateHasChanged();
        }
    }

    private async Task SetWifiManual(bool manual)
    {
        _wifiManual = manual;
        if (!manual) await SearchBridges();
    }

    private async Task SearchIfWifi()
    {
        if (_selectedAdapterType == "WiFi" && !_wifiManual && !_status.IsConnected)
            await SearchBridges();
    }

    private async Task OnAdapterTypeChanged(string obj)
    {
        _selectedAdapterType = obj;
        Refresh();
        await SearchIfWifi();
    }

}
