@using application.Services
@using web.Components.Shared
@inject NavigationManager Nav
@inject ConfigFileManager FileManager
@inject IJSRuntime JS
@implements IDisposable

@* The phone layout: a slim bar on top, the page, the main places at the bottom within thumb reach,
   and everything else in a menu that slides in from the left *@
<div class="m-shell">
    <header class="m-top">
        <button type="button" class="m-menu-btn" aria-label="Menu" aria-expanded="@(_menuOpen ? "true" : "false")"
                @onclick="OpenMenu">
            <MudIcon Icon="@Icons.Material.Filled.Menu"/>
        </button>
        <span class="m-brand">dingoConfig</span>
        <span class="m-file">@FileManager.CurrentFileName</span>
        <span class="m-grow"></span>
        <AdapterToolbarControl/>
    </header>

    <main class="m-main">
        @ChildContent
    </main>

    <nav class="m-nav" aria-label="Main">
        <a href="" class="@Current("")">
            <MudIcon Icon="@Icons.Material.Outlined.Home"/>
            <span>Home</span>
        </a>
        <a href="devices" class="@Current("device")">
            <MudIcon Icon="@Icons.Material.Outlined.Memory"/>
            <span>Devices</span>
        </a>
        <button type="button" class="@(_menuOpen ? "active" : "")" @onclick="OpenMenu">
            <MudIcon Icon="@Icons.Material.Outlined.Menu"/>
            <span>Menu</span>
        </button>
    </nav>
</div>

@* Plain markup rather than MudDrawer: that one needs the MudLayout the desktop layout has and this one doesn't *@
<div class="m-scrim @(_menuOpen ? "open" : "")" @onclick="CloseMenu"></div>
<aside class="m-side @(_menuOpen ? "open" : "")" aria-label="Menu" inert="@(!_menuOpen)">
    <div class="m-side-head">
        <span class="m-brand">dingoConfig</span>
        <button type="button" class="m-menu-btn" aria-label="Close menu" @onclick="CloseMenu">
            <MudIcon Icon="@Icons.Material.Filled.Close"/>
        </button>
    </div>

    <div class="m-side-group">
        <div class="m-side-title">Project</div>
        <div class="m-side-file">@(FileManager.CurrentFileName is { Length: > 0 } name ? name : "No file open")</div>
        @* A project action opens its own dialog, so the menu steps aside as soon as one is picked *@
        <div class="m-side-actions" @onclick="CloseMenu">
            <FileToolbar List="true" OnNew="OnNew" OnOpen="OnOpen" OnSave="OnSave" OnSaveAs="OnSaveAs"/>
        </div>
    </div>

    <div class="m-side-group">
        <a class="m-side-link @Current("")" href=""><MudIcon Icon="@Icons.Material.Outlined.Home"/>Home</a>
        <a class="m-side-link @Current("device")" href="devices"><MudIcon Icon="@Icons.Material.Outlined.Memory"/>Devices</a>
        <a class="m-side-link @Current("plot")" href="plot"><MudIcon Icon="@Icons.Material.Outlined.StackedLineChart"/>Plot</a>
        <a class="m-side-link @Current("can-log")" href="can-log"><MudIcon Icon="@Icons.Material.Outlined.Article"/>CAN log</a>
        <a class="m-side-link @Current("system-log")" href="system-log"><MudIcon Icon="@Icons.Material.Outlined.Notes"/>Messages</a>
    </div>

    <div class="m-side-group">
        <a class="m-side-link @Current("install")" href="install"><MudIcon Icon="@Icons.Material.Outlined.InstallMobile"/>Install app</a>
        <button type="button" class="m-side-link" @onclick="Help"><MudIcon Icon="@Icons.Material.Outlined.HelpOutline"/>Help</button>
        <button type="button" class="m-side-link" @onclick="DesktopView"><MudIcon Icon="@Icons.Material.Outlined.DesktopWindows"/>Desktop view</button>
    </div>
</aside>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }
    [Parameter] public EventCallback<string> OnOpen { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback<string> OnSaveAs { get; set; }
    [Parameter] public EventCallback OnHelp { get; set; }

    private bool _menuOpen;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        FileManager.OnStateChanged += OnFileChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(() =>
        {
            _menuOpen = false;
            StateHasChanged();
        });

    private void OnFileChanged() => InvokeAsync(StateHasChanged);

    // "" is the home page; other prefixes match their pages and those under them
    private string Current(string prefix)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        var active = prefix.Length == 0 ? path.Length == 0 : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
        return active ? "active" : "";
    }

    private void OpenMenu() => _menuOpen = true;

    private void CloseMenu() => _menuOpen = false;

    private async Task Help()
    {
        _menuOpen = false;
        await OnHelp.InvokeAsync();
    }

    private async Task DesktopView()
    {
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui-mode.js");
        await module.InvokeVoidAsync("setView", "desktop");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        FileManager.OnStateChanged -= OnFileChanged;
    }
}
