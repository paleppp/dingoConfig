@using System.Security.Cryptography
@using web.Services
@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#27272f" />
    <base href="/" />
    <link rel="stylesheet" href="lib/uplot/uPlot.min.css" />
    <link rel="stylesheet" href="@($"app.css?v={AppCssVersion}")" />
    <link rel="icon" type="image/png" href="icon.png" />
    @* Installable as an app: Android and Windows read the manifest, iOS the apple-* tags *@
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="pwa/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="dingoConfig" />
    <HeadOutlet />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <title>dingoConfig</title>
</head>

<body>
    <Routes Mobile="@UiMode.Detect(HttpContext)" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        // Browsers allow a service worker only over HTTPS or on localhost; elsewhere this is skipped
        if ("serviceWorker" in navigator) navigator.serviceWorker.register("service-worker.js").catch(() => {});
        // Chrome and Edge offer installing once, early; kept for the Install button on the Install app page
        window.addEventListener("beforeinstallprompt", e => { e.preventDefault(); window.dcInstallPrompt = e; });
        window.addEventListener("appinstalled", () => { window.dcInstallPrompt = null; });
    </script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private static string? _appCssVersion;

    // Changes whenever app.css does, so a browser that cached an older one fetches it again
    private string AppCssVersion => _appCssVersion ??= HashOf("app.css");

    private string HashOf(string path)
    {
        var file = Env.WebRootFileProvider.GetFileInfo(path);
        if (!file.Exists) return "0";
        using var stream = file.CreateReadStream();
        return Convert.ToHexString(SHA256.HashData(stream))[..12];
    }
}
