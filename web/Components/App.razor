@using System.Security.Cryptography
@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="lib/uplot/uPlot.min.css" />
    <link rel="stylesheet" href="@($"app.css?v={AppCssVersion}")" />
    <link rel="icon" type="image/png" href="icon.png" />
    <HeadOutlet />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <title>dingoConfig</title>
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code {
    private static string? _appCssVersion;

    // Changes whenever app.css does, so a browser that cached an older one fetches it again
    private string AppCssVersion => _appCssVersion ??= HashOf("app.css");

    private string HashOf(string path)
    {
        var file = Env.WebRootFileProvider.GetFileInfo(path);
        if (!file.Exists) return "0";
        using var stream = file.CreateReadStream();
        return Convert.ToHexString(SHA256.HashData(stream))[..12];
    }
}
